# Database (PostgreSQL + Neon/Local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_docs
NEON_ORG=your-neon-org
NEON_PROJECT=your-project
ENCRYPTION_KEY=default-dev-key-32chars-long!!!

# Vector Embeddings
PGVECTOR_URL=postgresql://postgres:postgres@localhost:5432/ai_docs

# AI Providers
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
